// Geodynamic World Builder world for gwb-slab-3d.cfg: a continental plate, an
// oceanic plate subducting beneath it at a trench along y, and a fault along
// the plate interface, in a 200 x 100 x 100 km box.
//
// In 3D the world needs no cross section: DES (x, y) are the world's map
// coordinates and the depth is -z. The features extend 50 km past the box on
// every side, so their edges stay outside the domain.
//
// The compositions are DES's materials, in the order of the cfg's [mat]
// arrays: 0 oceanic crust, 1 continental crust, 2 mantle. With
// mattype_option = 936 every point of the domain needs one of them, so the
// mantle layer fills the domain and each plate and the slab give their
// mantle part composition 2.
//
// Where features overlap, the later one in the list wins, and a composition
// model sets the compositions it does not list to zero. Distances are in
// metres, temperatures in kelvin, velocities in m/yr.
{
  "version":"1.2",
  "coordinate system":{"model":"cartesian"},
  // Global parameters of GWB's temperature models. bc.mantle_temperature in
  // the cfg matches the potential mantle temperature.
  "surface temperature":273, "potential mantle temperature":1573,
  "thermal expansion coefficient":3e-5, "specific heat":1000, "thermal diffusivity":1.0e-6,
  "features":[
    // Background: mantle at a uniform 1573 K, deeper than the 100 km box.
    {"model":"mantle layer", "name":"mantle", "max depth":200e3,
     "coordinates":[[-50e3,-50e3],[-50e3,150e3],[250e3,150e3],[250e3,-50e3]],
     "temperature models":[{"model":"uniform", "temperature":1573}],
     "composition models":[{"model":"uniform", "compositions":[2]}]},
    // Overriding plate, x < 80 km: an 80 km lithosphere with a linear
    // geotherm, 30 km of continental crust over mantle.
    {"model":"continental plate", "name":"overriding", "max depth":80e3,
     "coordinates":[[-50e3,-50e3],[-50e3,150e3],[80e3,150e3],[80e3,-50e3]],
     "temperature models":[{"model":"linear", "max depth":80e3, "top temperature":273, "bottom temperature":1573}],
     "composition models":[{"model":"uniform", "compositions":[1], "max depth":30e3},
                           {"model":"uniform", "compositions":[2], "min depth":30e3, "max depth":80e3}]},
    // Subducting plate, x > 80 km: a cooling plate from a ridge at x = 1000 km
    // (about 18 Myr old at the trench at 5 cm/yr), 7 km of oceanic crust over
    // mantle.
    {"model":"oceanic plate", "name":"ocean", "max depth":80e3,
     "coordinates":[[80e3,-50e3],[80e3,150e3],[250e3,150e3],[250e3,-50e3]],
     "temperature models":[{"model":"plate model", "max depth":80e3, "top temperature":273,
        "bottom temperature":1573, "spreading velocity":0.05,
        "ridge coordinates":[[[1000e3,-50e3],[1000e3,150e3]]]}],
     "composition models":[{"model":"uniform", "compositions":[0], "max depth":7e3},
                           {"model":"uniform", "compositions":[2], "min depth":7e3, "max depth":80e3}]},
    // The slab: from the trench at x = 80 km it dips toward the dip point
    // (-x, under the overriding plate), steepening from 0 to 30 degrees over
    // the first 60 km and to 45 over the next 80 km. Like the plate, it has
    // 7 km of oceanic crust on top. Its temperature is GWB's mass-conserving
    // slab model, referenced to the same plate model and ridge as the oceanic
    // plate; it also applies 20 km above the slab top, cooling the mantle
    // wedge next to the slab.
    {"model":"subducting plate", "name":"slab",
     "coordinates":[[80e3,-50e3],[80e3,150e3]], "dip point":[0,50e3], "max depth":200e3,
     "segments":[{"length":60e3, "thickness":[80e3], "angle":[0,30]},
                 {"length":80e3, "thickness":[80e3], "angle":[30,45]}],
     "composition models":[{"model":"uniform", "compositions":[0], "max distance slab top":7e3},
                           {"model":"uniform", "compositions":[2],
                            "min distance slab top":7e3, "max distance slab top":80e3}],
     "temperature models":[{"model":"mass conserving", "reference model name":"plate model",
        "density":3300, "thermal conductivity":3.3, "adiabatic heating":false,
        "spreading velocity":0.05, "subducting velocity":0.05,
        "ridge coordinates":[[[1000e3,-50e3],[1000e3,150e3]]],
        "coupling depth":60e3, "forearc cooling factor":20.0, "taper distance":60e3,
        "min distance slab top":-20e3, "max distance slab top":80e3}]},
    // The plate interface, DES's weak zone (weakzone_option = 936): the slab's
    // top surface, same trace and segments, to 60 km depth. It is 10 km
    // thick, centred on the slab top. Without temperature or composition
    // models it keeps those of the features above, and only marks the
    // elements that get weakzone_plstrain.
    {"model":"fault", "name":"plate interface", "max depth":60e3,
     "coordinates":[[80e3,-50e3],[80e3,150e3]], "dip point":[0,50e3],
     "segments":[{"length":60e3, "thickness":[10e3], "angle":[0,30]},
                 {"length":80e3, "thickness":[10e3], "angle":[30,45]}]}
  ]
}
